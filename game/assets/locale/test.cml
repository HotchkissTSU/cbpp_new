:generic    0
:array      1

cta_raster {
    width 1024
    height 512
    data 0
}

cta_mapping [
    {
        name "my_sprite"
        type $generic
        rect [0 0 16 16]
    }

    {
        name "my_array_sprite"
        type $array
        
        initial_pos     [16 0]
        size            [16 16]
        shift           [1  0]
    }
]
