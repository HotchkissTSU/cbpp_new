{
	"name":"CB++ main project file",

	"base":{
        "compiler" : "g++",
        "from_obj" : 0,
        "dynamic" : ["lib"],
        "static" : ["lib"],
        "link_static":[],
		"link_dynamic":[],
        "comp_params":"-std=c++17 -fPIC -g3",
		"link_params":"",
        "out_libfile":"lib",
        "include":["src", "src/cbpp"],
        "obj":".obj",
        "out":""
    },

	"targets":{
        "cbb3":{
			"type" : "EXE",
			"out":"game/bin",
            "link_static" : ["cbcl"],
            "static" : ["game/bin"],
            "link_params" : "-Wl,-rpath=.",
            "comp_params":"-std=c++17 -g3",
			"src":["src/cbb3/*.cpp"],
            "obj":".obj/cbep"
        },
		"cbsv":{
			"type" : "EXE",
			"out":"game",
            "link_static" : ["cbsv", "z", "GLX", "glfw3"],
            "static" : ["game/bin"],
            "link_params" : "-Wl,-rpath=./bin",
            "comp_params":"-std=c++17 -g3",
			"src":["src/cbep/*.cpp"],
            "obj":".obj/cbep"
        },
        
        "cbpp_client":{
            "type" : "OBJ",
            "include" : ["src/cbpp/include", "src"],
            "obj":".obj/cbpp/cl",
            "src":["src/cbpp/entity/client/*.cpp"]
        },

        "cbpp_shared":{
            "type" : "OBJ",
            "include" : ["src/cbpp/include", "src"],
            "obj":".obj/cbpp",
            "src":["src/cbpp/*.cpp", "src/cbpp/entity/shared/*.cpp"]
        },

        "cbpp_server":{
            "type" : "OBJ",
            "include" : ["src/cbpp/include", "src"],
            "obj":".obj/cbpp/sv",
            "src":["src/cbpp/entity/server/*.cpp"]
        },

        "yyjson" : {
            "compiler" : "gcc",
            "type" : "OBJ",
            "obj":".obj/yyjson",
            "src":["src/yyjson/*.c"],
            "include":["src/yyjson"],
            "comp_params":"-fPIC -O2"
        },

        "libz" : {
            "type" : "DLL",
            "compiler" : "gcc",
            "comp_params" : "-D_LARGEFILE64_SOURCE=1 -DHAVE_HIDDEN -O2 -fPIC",
            "src" : ["src/zlib/*.c"],
            "obj" : ".obj/zlib",
            "include" : "src/zlib",
            "out" : "game/bin"
        },

        "cdf" : {
            "compiler":"gcc",
            "type" : "OBJ",
            "obj":".obj",
            "src":["src/cdf/*.c"],
            "include":["src/cdf", "src/zlib"],
            "comp_params":"-fPIC -O2 -DCDF_USE_ZLIB"
        },

        "libcbsv" : {
            "type" : "DLL",
            "from_obj" : 1,
            "out" : "game/bin",
            "src" : [".obj/cbpp/*.o", ".obj/gl/gl40.o", ".obj/yyjson/*.o", ".obj/*.o", ".obj/cbpp/sv/*.o"],
            "link_static" : ["z"]
        },

        "libcbcl" : {
            "type" : "DLL",
            "from_obj" : 1,
            "out" : "game/bin",
            "src" : [".obj/cbpp/*.o", ".obj/gl/gl40.o", ".obj/yyjson/*.o", ".obj/*.o", ".obj/cbpp/cl/*.o"],
            "link_static" : ["z"]
        }
	}
}
