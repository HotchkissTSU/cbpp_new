{
	"name":"CB++ main project file",

	"base":{
        "compiler" : "g++",
        "from_obj" : 0,
        "dynamic" : ["lib"],
        "static" : ["lib"],
        "link_static":[],
		"link_dynamic":[],
        "comp_params":"-std=c++17 -fPIC -g3",
		"link_params":"",
        "out_libfile":"lib",
        "include":["src", "include"],
        "obj":".obj",
        "out":""
    },

	"targets":{
        "cbb":{
			"type" : "EXE",
			"out":"game/bin",
            "link_static" : ["cbcl"],
            "static" : ["game/bin"],
            "link_params" : "-Wl,-rpath=.",
            "comp_params":"-std=c++17 -g3",
			"src":["src/cbb/*.cpp"],
            "obj":".obj/sdk"
        },

        "stb":{
            "type":"OBJ",
            "include" : ["src", "include"],
            "obj" : ".obj/cbpp",
            "comp_params":"-O2 -fPIC",
            "src" : ["src/stb/*.cpp"]
        },
        
		"cbsv":{
			"type" : "EXE",
			"out":"game",
            "link_static" : ["cbsv", "z", "GLX", "glfw3"],
            "static" : ["game/bin"],
            "link_params" : "-Wl,-rpath=./bin",
            "comp_params":"-std=c++17 -g3",
			"src":["src/cbsv/*.cpp"],
            "obj":".obj/cbsv"
        },
        
        "cbpp_client":{
            "type" : "OBJ",
            "include" : ["include", "src"],
            "obj":".obj/cbpp/cl",
            "src":["src/engine/entity/client/*.cpp"]
        },

        "cbpp_shared":{
            "type" : "OBJ",
            "include" : ["include", "src"],
            "obj":".obj/cbpp",
            "src":[ "src/engine/*.cpp", 
                    "src/engine/entity/shared/*.cpp",
                    "src/engine/cml/*.cpp" ]
        },
        
        "cbpp_server":{
            "type" : "OBJ",
            "include" : ["include", "src"],
            "obj":".obj/cbpp/sv",
            "src":["src/engine/entity/server/*.cpp"]
        },

        "libz" : {
            "type" : "DLL",
            "compiler" : "gcc",
            "comp_params" : "-D_LARGEFILE64_SOURCE=1 -DHAVE_HIDDEN -O2 -fPIC",
            "src" : ["src/zlib/*.c"],
            "obj" : ".obj/zlib",
            "include" : "src/zlib",
            "out" : "game/bin"
        },

        "libcbsv" : {
            "type" : "DLL",
            "from_obj" : 1,
            "out" : "game/bin",
            "src" : [".obj/cbpp/*.o", ".obj/gl/gl40.o", ".obj/jsoncpp/*.o", ".obj/*.o", ".obj/cbpp/sv/*.o"],
            "link_static" : ["z"]
        },

        "libcbcl" : {
            "type" : "DLL",
            "from_obj" : 1,
            "out" : "game/bin",
            "src" : [".obj/cbpp/*.o", ".obj/gl/gl40.o", ".obj/jsoncpp/*.o", ".obj/*.o", ".obj/cbpp/cl/*.o"],
            "link_static" : ["z"]
        }
	}
}
